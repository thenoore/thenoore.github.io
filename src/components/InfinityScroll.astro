<style>
    

    @media (orientation: landscape) {
        .subHeading {
            margin: 5rem auto;
            font-size: 2rem;
            text-align: center;
            font-weight: lighter;
            font-family: "Aboreto", system-ui;
            word-spacing: .5rem;
        }

        .infinityBlock {
            margin: 10rem auto;
            user-select: none;
            -moz-user-select: none;
        }

        .carousel {
            margin: 5rem auto;
            width: 100%;
            display: flex;
            overflow-x: hidden;
        }

        .carousel::-webkit-scrollbar {
            display: none;
        }

        .group {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 1em;
            animation: spin 15s infinite linear;
            padding-right: 1em;
        }

        .card {
            flex: 0 0 10rem;
            height: 5rem;
            padding: 1em;
            text-align: center;
            align-content: center;
            cursor: pointer;
        }

        @keyframes spin {
            from {translate: 0;}
            to {translate: -100%;}
        }
    }

    @media (orientation: portrait) {
        .infinityBlock {
            margin: 10rem auto;
            user-select: none;
            -moz-user-select: none;
        }

        .subHeading {
            width: 90%;
            margin: 5rem auto;
            text-align: center;
            font-weight: lighter;
            font-family: "Aboreto", system-ui;
            font-size: 2rem;
        }

        .mobile {
            display: none;
        }

        .carousel {
            margin: 5rem auto;
            width: 100%;
            display: flex;
            flex-shrink: 0;
            justify-content: start;
            overflow-x: hidden;
            will-change: transform;
        }

        .carousel::-webkit-scrollbar {
            display: none;
        }

        .group {
            display: flex;
            align-items: center;
            justify-content: start;
            flex-shrink: 0;
            gap: 1em;
            animation: spin 10s infinite linear;
            padding-right: 1em;
            will-change: transform;
        }

        @keyframes spin {
            from {transform: translateX(0);}
            to {transform: translateX(-100%);}
        }

        .card {
            flex-shrink: 0;
            flex: 0 0 auto;
            width: 7rem;
            height: 5rem;
            padding: 1em;
            text-align: center;
        }
    }
</style>