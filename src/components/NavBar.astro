<header>
    <nav>
        <a id="brandName" href="/">Noore</a>

        <button class="menuBtn" id="menuBtn" aria-label="Toggle menu">
            <svg
                class="icon-menu"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round">
                <path d="M4 5h16" />
                <path d="M4 12h16" />
                <path d="M4 19h16" />
            </svg>

            <svg
                class="icon-close"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round">
                <path d="M18 6 6 18" />
                <path d="m6 6 12 12" />
            </svg>
        </button>

        <div class="wrapper" id="menu">
            <div class="links">
                <a href="/shop">Shop</a>
                <a href="/about">About</a>
                <a href="/contact">Contact</a>
            </div>
        </div>
    </nav>
</header>
<div class="menu-overlay" id="menuOverlay"></div>

<script is:inline>

function initMobileMenu() {
    const menu = document.getElementById("menu");
    const btn = document.getElementById("menuBtn");
    const overlay = document.getElementById("menuOverlay");

    if (!menu || !btn || !overlay) return;

    function closeMenu() {
        menu.classList.remove("show");
        overlay.classList.remove("show");
        btn.classList.remove("is-open");
        btn.setAttribute("aria-expanded", "false");
    }

    btn.addEventListener("click", (e) => {
        e.stopPropagation();

        const isOpen = menu.classList.contains("show");

        if (isOpen) {
            closeMenu();
        } else {
            menu.classList.add("show");
            overlay.classList.add("show");
            btn.classList.add("is-open");
            btn.setAttribute("aria-expanded", "true");
        }
    });

    overlay.addEventListener("click", closeMenu);

    menu.addEventListener("click", (e) => {
        e.stopPropagation();
    });
}

document.addEventListener("astro:page-load", initMobileMenu);
document.addEventListener("astro:after-swap", initMobileMenu);

</script>

<style>

    header {
        /* background-image: linear-gradient(140deg, #B57BEE, #392D69); */
        /* background-color: #579e78; */
        background-color: var(--primary);
        color: white;
        padding: 1.5rem 1rem;
        margin: 1rem;
        position: relative;
        z-index: 901;
    }

    @media (orientation: landscape) {
        nav {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .menuBtn, #menuBtn, menuOverlay {
            display: none;
        }
        
        #brandName {
            font-family: "Aboreto", system-ui;
            font-weight: bold;
            font-style: normal;
            font-size: 2rem;
            text-shadow: 0px 2px 3px rgba(0,0,0,0.5);
            text-decoration: none;
            color: white;
        }

        .wrapper {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .links {
            font-family: "Aboreto", system-ui;
            font-weight: 400;
            font-style: normal;
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            padding-right: 1rem;
        }
        
        .links a {
            margin-left: 2rem;
            position: relative;
            text-decoration: none;
            text-align: center;
        }

        .links a::after {
            content: "";
            position: absolute;
            left: 0;
            bottom: -3px; /* spacing from text */
            width: 100%;
            height: 2px;
            background: #fff;

            transform: scaleX(0);
            transform-origin: right;
            transition: transform 0.4s ease;
        }

        .links a:hover::after {
            transform: scaleX(1);
            transform-origin: left;
        }
    }

    @media (orientation: portrait) {

        nav {
            position: relative;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .menuBtn {
            margin: 0px;
            padding: 0px;
            font-size: 2rem;
            background: none;
            border: none;
            color: #fafafa;
            cursor: pointer;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        #brandName {
            font-family: "Aboreto", system-ui;
            font-weight: bold;
            font-size: 1.5rem;
            text-decoration: none;
            color: white;
        }

        /* DROPDOWN CONTAINER */
        #menu {
            position: absolute;
            z-index: 1000;
            top: calc(100% + 1rem);
            left: -1rem;
            width: calc(100% + 2rem);
            overflow: hidden;
            max-height: 0;
            background-color: var(--primary);
            transition: max-height 0.5s ease, padding 0.5s ease;
            padding: 0 1rem;
            box-sizing: border-box;
            transform-origin: top;
        }

        /* OPEN STATE */
        #menu.show {
            max-height: 15rem;
            padding: 1rem 1rem 1.5rem 1rem;
        }

        .links {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            align-items: center;
        }

        #menu a {
            text-decoration: none;
            color: white;

            opacity: 0;
            transform: translateY(-10px);

            transition:
                opacity 0.5s ease,
                transform 0.5s ease;
        }

        /* animate links in */
        #menu.show a {
            opacity: 1;
            transform: translateY(0);
        }

        #menu.show a:nth-child(1) {
            transition-delay: 0.05s;
        }

        #menu.show a:nth-child(2) {
            transition-delay: 0.15s;
        }

        #menu.show a:nth-child(3) {
            transition-delay: 0.25s;
        }

        .menu-overlay {
            position: fixed;
            inset: 0;

            backdrop-filter: blur(3px);
            -webkit-backdrop-filter: blur(3px);
            
            background: hsla(0, 0%, 97%, .01);

            opacity: 0;
            pointer-events: none;

            transition: opacity 0.5s ease;

            z-index: 900;
        }

        .menu-overlay.show {
            opacity: 1;
            pointer-events: auto;
        }

        .menuBtn .icon-close {
            display: none;
        }

        .menuBtn.is-open .icon-menu {
            display: none;
        }

        .menuBtn.is-open .icon-close {
            display: block;
        }
    }

</style>
