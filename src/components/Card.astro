---
import { Image } from 'astro:assets';

interface Props {
    url: any;
    productName: string;
    price: string;
    ctaLink: string;
    alt: string;
}

const { url, productName, price, ctaLink, alt } = Astro.props;
---

<a href={ctaLink} class="parentAtag">
    <div class="productCard" >
        <div class="imageHolder">
            <Image transition:name={productName} src={url} alt={alt} class='cardImage' />
        </div>

        <div class="content">
            <h4 transition:name={`${productName}-name`} class="productName">{productName}</h4>
            <p transition:name={`${productName}-price`} class="price">￡{price}</p>
        </div>
    </div>
</a>

<style>

    h4, p {
        margin: 0px; padding: 0px;
    }

    .content {
        height: 10%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 1rem;
    }

    .productName {
        font-weight: 400;
        font-style: normal;
        text-transform: uppercase;
    }

    .price {
        font-weight: 400;
        font-style: italic;
        padding-right: .5rem;
        color: #fafafa;
        /* background-color: #B57BEE; */
        background-color: var(--dark);
    }

    @media (orientation: landscape) {
        .productCard {
            width: 100%;
            aspect-ratio: 9 / 13.5;
            overflow: hidden;
            background-color: #fafafa;
            transition: all .2s linear;
        }
        
        .productCard:hover {
            box-shadow: rgba(0, 0, 0, 0.16) 0px 1px 4px;
            img {
                transform: scale(1.05);
            }
        }

        .imageHolder {
            overflow: hidden;
            width: 100%;
            height: 90%;
            background-color: var(--light);
        }

        .cardImage {
            object-fit: contain;
            width: 100%;
            height: 100%;
            transition: all .2s ease-in;
        }
    }

    @media (orientation: portrait) {

        .parentAtag {
            width: min(100%, 40vh);
            display: block;
            text-align: center;
            text-decoration: none;
        }

        .productCard {
            width: 100%;
            aspect-ratio: 2/2.5;
            overflow: hidden;
            background-color: #fff;
            transition: all .2s linear;
            box-shadow: rgba(0, 0, 0, 0.02) 0px 1px 3px 0px, rgba(27, 31, 35, 0.15) 0px 0px 0px 1px;
        }
        
        .imageHolder {
            overflow: hidden;
            width: 100%;
            height: 90%;
            object-fit: cover;
            background-color: var(--light);
        }

        .cardImage {
            object-fit: cover;
            width: 100%;
            height: 100%;
            transition: all .2s ease-in;
        }
    }

</style>