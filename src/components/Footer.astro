---
const year = new Date().getFullYear();
---

<footer>

    <div class="banner">
        <div class="leftColumn">
            <a href="/faqs">FAQs</a>
            <a href="/terms-and-conditions">Terms & Conditions</a>
            <a href="/return-and-exchange">Return & Exchange Policy</a>
        </div>
        <p class="brandName">Noore</p>
        <div class="rightColumn">
            <a href="/">Instagram</a>
            <a href="/">TikTok</a>
            <a href="/">X</a>
        </div>
    </div>

    <p id="copyright">Noore © {year} | All Rights Reserved</p>
</footer>

<style>
    footer {
        width: 100vw;
        /* background-image: linear-gradient(140deg, #B57BEE, #392D69); */
        /* background-color: #579e78; */
        background-color: var(--primary);
        color: #fafafa;
        overflow: hidden;
    }

    p {
        margin: 0px;
        padding: 0px;
    }

    #copyright {
        text-align: center;
        margin-bottom: 1rem;
    }

    a {
        font-family: "Aboreto", system-ui;
        font-weight: 400;
        font-style: normal;
        /* display: inline-block; */
    }

    @media (orientation: landscape) {
        .banner {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 90vw;
            margin: 7rem auto;
        }

        .leftColumn {
            width: 20%;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            row-gap: 1rem;
        }

        .rightColumn {
            width: 20%;
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            row-gap: 1rem;
        }

        .brandName {
            width: 60%;
            text-align: center;

            font-family: "Aboreto", system-ui;
            font-weight: bold;
            font-style: normal;
            font-size: 4rem;
            text-shadow: 0px 2px 3px rgba(0,0,0,0.5);
            text-decoration: none;
        }

        a {
            margin-left: 2rem;
            position: relative;
            text-decoration: none;
        }

        a::after {
            content: "";
            position: absolute;
            left: 0;
            bottom: -5px; /* spacing from text */
            width: 100%;
            height: 2px;
            background: #fff;

            transform: scaleX(0);
            transform-origin: right;
            transition: transform 0.4s ease;
        }

        a:hover::after {
            transform: scaleX(1);
            transform-origin: left;
        }
    }

    @media (orientation: portrait) {
        .banner {
            display: grid;
            /* justify-content: space-between; */
            align-items: center;
            width: 90vw;
            margin: 7rem auto;
            text-align: center;
        }

        .leftColumn, .rightColumn {
            width: 100%;
            display: grid;
            row-gap: 1rem;
            text-decoration: 1px underline #FAF8F4;
            text-underline-offset: 5px;
        }

        .brandName {
            width: 100%;
            font-family: "Aboreto", system-ui;
            font-weight: bold;
            font-style: normal;
            font-size: 3rem;
            text-shadow: 0px 2px 3px rgba(0,0,0,0.1);
            text-decoration: none;
            margin: 5rem 0;
        }
    }
</style>
