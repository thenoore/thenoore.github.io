---
import { Image } from "astro:assets";

interface Props {
    ingredient: {image: any, ingre: string};
}

const { ingredient } = Astro.props;
---

<div class="ingredientCard">
    <div class="imageWrapper">
        <Image src={ingredient.image} alt={ingredient.ingre} class="image" />
    </div>
    <p class="name">{ingredient.ingre}</p>
</div>

<style>
    @media (orientation: landscape) {
        .ingredientCard {
            width: 12rem;
            user-select: none;
            -moz-user-select: none;
            -webkit-user-drag: none;
        }

        .image {
            width: 12rem;
            height: 12rem;
            object-fit: cover;
            margin: 0 0 .5rem 0;
            user-select: none;
            -moz-user-select: none;
            -webkit-user-drag: none;
        }

        .name {
            text-align: center;
            font-size: 1.1rem;
        }
    }

    @media (orientation: portrait) {
        .ingredientCard {
            width: 100%;
            text-align: center;
            user-select: none;
            -moz-user-select: none;
            -webkit-user-drag: none;
        }

        .image {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            user-select: none;
            -moz-user-select: none;
            -webkit-user-drag: none;
        }


        .imageWrapper {
            width: 100%;
            aspect-ratio: 1 / 1;
            margin: 0 0 .5rem 0;
        }

        .name {
            font-size: 1.1rem;
        }
    }
</style>